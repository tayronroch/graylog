# =============================================================================
# Graylog (Open) + Data Node + MongoDB externo
#
# Copie para .env (docker compose local/servidor) ou cadastre cada variável na
# aba "Environment Variables" do Coolify. NUNCA commite o .env.
# Todas as variáveis marcadas OBRIGATÓRIA fazem o `docker compose config`
# falhar se estiverem vazias.
# =============================================================================

# --------------------------------------------------
# Images (versões FIXAS - nunca usar "latest")
# --------------------------------------------------
# Graylog Server e Data Node DEVEM estar na mesma versão (major.minor.patch).
# Validado em 2026-10-13: 7.1.10 é o último patch da série 7.1 (estável);
# 7.2.0 foi publicada em 2026-10-12 (ver docs/OPERATIONS.md > Upgrade).
GRAYLOG_VERSION=7.1.10
DATANODE_VERSION=7.1.10

# --------------------------------------------------
# MongoDB externo (OBRIGATÓRIA)
# --------------------------------------------------
# Connection string COMPLETA do MongoDB criado como recurso separado.
# Hostname, usuário, senha, porta, database, replicaSet e authSource vêm só
# daqui; o projeto não assume nenhum hostname.
# Usada pelo Graylog Server (GRAYLOG_MONGODB_URI) e pelo Data Node
# (GRAYLOG_DATANODE_MONGODB_URI) - a mesma URI nos dois.
# Usuário e senha precisam estar URL-encoded (@ -> %40, / -> %2F, : -> %3A,
# + -> %2B, # -> %23, ? -> %3F, % -> %25). Veja docs/MONGODB.md.
# Exemplo (apenas documental, NÃO use):
#   mongodb://graylog:CHANGE_ME@mongodb-internal:27017/graylog?authSource=admin
MONGODB_URI=

# --------------------------------------------------
# Graylog Security (OBRIGATÓRIAS)
# --------------------------------------------------
# Pepper de senhas / chave de proteção de dados sensíveis no MongoDB (inclui a
# CA do Data Node). Mínimo 16 caracteres, recomendado >= 64 (o script gera 96).
# O MESMO valor vale para Graylog Server e Data Node.
# Gere com: ./scripts/generate-password-secret.sh
# ATENÇÃO: trocar depois da instalação invalida sessões e valores criptografados
# no MongoDB. Guarde em cofre de senhas.
GRAYLOG_PASSWORD_SECRET=

# SHA-256 da senha do usuário "admin" (root). Gere com:
#   ./scripts/generate-admin-password-hash.sh
GRAYLOG_ROOT_PASSWORD_SHA2=

# --------------------------------------------------
# HTTP
# --------------------------------------------------
# URL pública (HTTPS do Coolify), terminando em "/". OBRIGATÓRIA.
GRAYLOG_HTTP_EXTERNAL_URI=https://graylog.directtelecom.net.br/
# Endereço de bind dentro do container. O Coolify roteia o domínio para :9000.
GRAYLOG_HTTP_BIND_ADDRESS=0.0.0.0:9000

# Healthcheck: true aceita a UI de preflight (primeiro boot) como saudável para
# o proxy conseguir rotear até ela. Depois do setup troque para false
# (exige /api/system/lbstatus = 200 ALIVE). Ver docs/FIRST-BOOT.md.
HEALTHCHECK_ALLOW_PREFLIGHT=true

# --------------------------------------------------
# Timezone
# --------------------------------------------------
TZ=America/Fortaleza
# Fuso do usuário root/UI. (O fuso de equipamentos que enviam RFC3164 sem
# timezone é configurado no próprio input Syslog - ver docs/SYSLOG.md.)
GRAYLOG_ROOT_TIMEZONE=America/Fortaleza

# --------------------------------------------------
# Syslog
# --------------------------------------------------
# Porta publicada no host em TCP e UDP (host = container). Os inputs criados
# no Graylog devem escutar esta mesma porta.
SYSLOG_PORT=5140

# --------------------------------------------------
# Journal (persistido no volume graylog-data)
# --------------------------------------------------
# Deve caber com folga no disco do volume. Mensagens não processadas além
# destes limites são DESCARTADAS. Ver docs/STORAGE.md.
GRAYLOG_MESSAGE_JOURNAL_MAX_SIZE=10gb
GRAYLOG_MESSAGE_JOURNAL_MAX_AGE=24h

# --------------------------------------------------
# JVM / memória
# --------------------------------------------------
# Heap do Graylog Server (acrescentado às opções padrão da imagem).
GRAYLOG_SERVER_JAVA_OPTS=-Xms2g -Xmx2g
# Heap do OpenSearch embutido no Data Node (GRAYLOG_DATANODE_OPENSEARCH_HEAP).
# Regra: <= 50% da RAM do host e nunca acima de ~31g. O container do Data Node
# usa ainda ~1g do processo Java do próprio Data Node + memória off-heap.
# Referência para host de 16 GB: servidor 2g + Data Node 4g.
DATANODE_HEAP=4g
